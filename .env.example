# Exemplo documental; não carregar sem substituir os placeholders.
# Usar arquivos privados 0600 fora do checkout. Não publicar valores reais.
RM_DB_URL=<JDBC_POSTGRESQL_EXCLUSIVO_LOOPBACK>
RM_DB_USER=<ROLE_RUNTIME_DO_AMBIENTE>
RM_DB_PASSWORD=<SEGREDO_RUNTIME_GERADO_LOCALMENTE>
RM_MIGRATION_USER=<ROLE_OWNER_DO_AMBIENTE>
RM_MIGRATION_PASSWORD=<SEGREDO_OWNER_GERADO_LOCALMENTE>
RM_STAGE=<dev_ou_test_ou_hml>
RM_PORT=<PORTA_LOOPBACK_DO_AMBIENTE>
# Opcional: mesmo domínio no HTTP e CLI; omitir para usar plataforma.localhost.
RM_PLATFORM_HOST=<DOMINIO_SAAS_RESERVADO>
RM_JWT_SECRET=<CHAVE_ALEATORIA_PRIVADA_COM_MINIMO_64_BYTES>
RM_JWT_KEY_ID=<IDENTIFICADOR_PUBLICO_DA_CHAVE_ATIVA>
# Sobreposição opcional de rotação: configurar ambos ou omitir ambos.
RM_JWT_PREVIOUS_SECRET=<CHAVE_ANTERIOR_PRIVADA>
RM_JWT_PREVIOUS_KEY_ID=<IDENTIFICADOR_DA_CHAVE_ANTERIOR>
# Migrador recebe owner; processo HTTP recebe só RM_DB_URL/USER/PASSWORD/STAGE.
