# Exemplo documental; não carregar sem substituir os placeholders.
# Usar arquivos privados 0600 fora do checkout. Não publicar valores reais.
RM_DB_URL=<JDBC_POSTGRESQL_EXCLUSIVO_LOOPBACK>
RM_DB_USER=<ROLE_RUNTIME_DO_AMBIENTE>
RM_DB_PASSWORD=<SEGREDO_RUNTIME_GERADO_LOCALMENTE>
RM_MIGRATION_USER=<ROLE_OWNER_DO_AMBIENTE>
RM_MIGRATION_PASSWORD=<SEGREDO_OWNER_GERADO_LOCALMENTE>
RM_STAGE=<dev_ou_test_ou_hml>
RM_PORT=<PORTA_LOOPBACK_DO_AMBIENTE>
# Opcional: mesmo domínio no HTTP e CLI; omitir para usar plataforma.localhost.
RM_PLATFORM_HOST=<DOMINIO_SAAS_RESERVADO>
RM_JWT_SECRET=<CHAVE_ALEATORIA_PRIVADA_COM_MINIMO_64_BYTES>
RM_JWT_KEY_ID=<IDENTIFICADOR_PUBLICO_DA_CHAVE_ATIVA>
# Sobreposição opcional de rotação: configurar ambos ou omitir ambos.
RM_JWT_PREVIOUS_SECRET=<CHAVE_ANTERIOR_PRIVADA>
RM_JWT_PREVIOUS_KEY_ID=<IDENTIFICADOR_DA_CHAVE_ANTERIOR>
# Migrador recebe owner; processo HTTP nunca recebe RM_MIGRATION_USER/PASSWORD.
# Identidade usa HTTPS; chaves e captura ficam fora do checkout.
RM_EMAIL_SECRET=<CHAVE_PRIVADA_32_BYTES_EM_BASE64>
RM_EMAIL_CAPTURE_DIRECTORY=<DIRETORIO_PRIVADO_ABSOLUTO_DE_CAPTURA>
SERVER_SSL_KEY_STORE=file:<CAMINHO_PRIVADO_ABSOLUTO_PKCS12>
SERVER_SSL_KEY_STORE_PASSWORD=<SEGREDO_PRIVADO_DO_PKCS12>
SERVER_SSL_KEY_STORE_TYPE=PKCS12
RM_TLS_TRUST_CERTIFICATE=<CAMINHO_PRIVADO_ABSOLUTO_PEM_DE_CONFIANCA>
# Pagamentos opcionais: omitir o grupo inteiro enquanto não configurado.
# Homologação usa somente contas de teste autorizadas; configuração não comprova sandbox.
RM_PAGAMENTOS_SECRET=<CHAVE_PRIVADA_32_BYTES_EM_BASE64>
RM_PAGAMENTOS_CLIENT_ID=<IDENTIFICADOR_DA_APLICACAO_MERCADO_PAGO>
RM_PAGAMENTOS_CLIENT_SECRET=<SEGREDO_PRIVADO_DA_APLICACAO>
RM_PAGAMENTOS_WEBHOOK_SECRET=<SEGREDO_PRIVADO_DE_ASSINATURA>
RM_PAGAMENTOS_PORTA_PUBLICA=<PORTA_HTTPS_PUBLICA>
