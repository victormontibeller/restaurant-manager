{
  "name": "restaurant-manager-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "ng build && node ../scripts/build-pwa.cjs",
    "start": "ng serve --host 127.0.0.1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc -p tsconfig.e2e.json",
    "test:logic": "node ../scripts/test-frontend.cjs",
    "test:templates": "bash ../scripts/test-profile-templates.sh",
    "e2e": "playwright test",
    "format": "prettier --write \"src/**/*.ts\" \"src/app/{pedidos,mesas,cozinha,financeiro,delivery,pagamentos,relatorios}/**/*.{html,css}\" \"src/app/unidades/prazos-aceite.component.{html,css}\" \"src/app/operacao.css\" \"e2e*/**/*.ts\" \"playwright*.config.ts\" \"../scripts/test*.cjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"src/app/{pedidos,mesas,cozinha,financeiro,delivery,pagamentos,relatorios}/**/*.{html,css}\" \"src/app/unidades/prazos-aceite.component.{html,css}\" \"src/app/operacao.css\" \"e2e*/**/*.ts\" \"playwright*.config.ts\" \"../scripts/test*.cjs\""
  },
  "dependencies": {
    "@angular/cdk": "22.2.4",
    "@angular/common": "22.2.4",
    "@angular/compiler": "22.2.4",
    "@angular/core": "22.2.4",
    "@angular/forms": "22.2.4",
    "@angular/platform-browser": "22.2.4",
    "@angular/router": "22.2.4",
    "@spartan-ng/brain": "1.9.0",
    "@tailwindcss/postcss": "4.3.5",
    "clsx": "2.1.1",
    "qrcode-generator": "2.0.4",
    "rxjs": "7.8.2",
    "tailwindcss": "4.3.5",
    "tslib": "2.8.1",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.5",
    "@angular/cli": "22.2.5",
    "@angular/compiler-cli": "22.2.4",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "prettier": "3.9.10",
    "typescript": "6.0.2"
  },
  "engines": {
    "node": ">=26.0.0 <27"
  }
}
